# Copy to infra/.env (gitignored) to override the local defaults. Never commit real credentials.
CORB_DB_USER=corb
CORB_DB_PASSWORD=change_me
CORB_DB_NAME=corb
CORB_DB_PORT=5433

# INF-P2-T04 tester containers: a YWO-Trade DEMO (or investor) login. Never the live account.
CORB_MT5_LOGIN=
CORB_MT5_PASSWORD=
CORB_MT5_SERVER=YWO-Trade

# INF-P5-T02 / T06: generated into infra/.env by `python -m corb ops roles` and `ops grafana` when missing
CORB_DB_INGEST_RW_PASSWORD=
CORB_DB_TRAIN_RW_PASSWORD=
CORB_DB_AGENT_RO_PASSWORD=
CORB_GRAFANA_ADMIN_PASSWORD=
