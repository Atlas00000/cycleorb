; AOS-P1 observe-all preset for CTRL-AAPL (AOS-P1-T01..T06: ledger, shadow, L1 features, events, context)
; Base: CycleORB-M5-AAPL-6M-NY-RESEARCH.set (frozen production). Changed inputs: InpAosLedger=true, InpAosRunTag=P1obs, InpAosEventCcy=USD, InpAosCtxSymbols=SPX500,DE30
; Hypothesis: zero behaviour change. Expected skip/fire change: 0 %. Must equal the AOS-P0 baseline event by event (aos_compare: withheld 0, added 0, changed 0)
; CycleORB v1.05 (needs v1.05+: InpTrendSideOnly) — AAPL (YWO symbol Apple) M5 chart preset, New York cash-open ORB
; *** RESEARCH ONLY — NOT PRODUCTION *** fitted to the 6-month tip 2026-05 -> 2026-10; the 2024-02 -> 2026-04 back-check is NEGATIVE (-0.12R/trade)
; Research: Ouroboros research/assets/AAPL/CycleORB_M5_review.md
; Broker clock YWO-Trade = UTC+0 -> fixed offset 0 (broker Apple history before 2025-06-18 is stamped UTC+3: tester runs valid from 2025-06-18 only)
; Session: range 09:30-10:00 New York (cash open), entries until 13:30, flat 15:55 (Apple is quoted only 09:30-15:59)
; Geometry: stop = opposite range edge, TP = 1.1 x stop distance (never TP < SL; EA refuses TargetR < 1 and skips any side whose TP distance < SL distance)
; Regime filters: only the side of the previous D1 close vs D1 SMA(20) is armed, AND range 20-80% of previous daily ATR(14); cost cap off (spread enters as cost)
; Risk: 0.5% per trade (half the usual 1%: research preset with a negative back-check)
; Tester (real ticks) tip 2026-05 -> 10: 32 trades, WR 53.1% vs BWR 47.7%, +1.0%, +0.06R/trade before the framework slippage prior, -0.02R after (Fragile)
;
; === Server time ===
InpServerTZ=1
InpServerFixedOffsetH=0
; === London setup — OFF (Apple not quoted in London hours) ===
InpLonEnable=false
InpLonRangeStart=08:00
InpLonRangeMinutes=30
InpLonEntryEnd=11:00
InpLonExit=16:00
; === New York setup (New York local time) = US cash open ===
InpNYEnable=true
InpNYRangeStart=09:30
InpNYRangeMinutes=30
InpNYEntryEnd=13:30
InpNYExit=15:55
; === Tokyo setup - OFF (explicit: a chart or the tester keeps the previous value of any input a .set omits) ===
InpTkyEnable=false
InpTkyRangeStart=09:00
InpTkyRangeMinutes=60
InpTkyEntryEnd=11:30
InpTkyExit=15:25
; === Entry / exit ===
InpStopMode=0
InpTargetR=1.1
InpBufferSpreadMult=2.0
InpBufferRangePct=5.0
; === Filters (regime) ===
InpATRPeriod=14
InpMinRangeATRPct=20.0
InpMaxRangeATRPct=80.0
InpMaxCostRangePct=100.0
InpCommissionPoints=0
InpMinVolPct=0.0
InpVolATRPeriod=20
InpVolLookback=500
InpTrendSideOnly=true
InpTrendMAPeriod=20
; === Calendar - NYSE holidays + 13:00 early closes 2025-07 -> 2027 (exit is after the early close) ===
InpSkipDates=250703,250704,250901,251127,251128,251224,251225,260101,260119,260216,260403,260525,260619,260703,260907,261126,261127,261224,270101,270118,270215,270326,270531,270618,270705,270906,271125,271126,271224
; === Monthly cycle ===
InpCycleCapital=0.0
InpSoftHaltPct=30.0
InpHardFlattenPct=38.0
InpRatchetArmPct=20.0
InpRatchetFloorPct=10.0
InpRatchetTrail=0.5
InpRiskDivisor=8.0
InpMaxRiskPct=0.5
InpNoEntryLastDay=true
; === AI OS observe (ledger, shadow, features; never changes trading) ===
InpAosLedger=true
InpAosRunTag=P1obs
InpAosEventCcy=USD
InpAosCtxSymbols=SPX500,DE30
InpAosCtxHours=8
; === AI OS policy L2 (permit / withhold / resize; defaults = engine unchanged) ===
InpAosLongGate=0
InpAosShortGate=0
InpAosCtxGateATR=0.5
InpAosEventNames=
InpAosEventWindow=0
InpAosEventSizeMult=1.0
InpAosCancelBeforeMin=0
InpAosCellAtrMin=0.0
InpAosCellAtrMax=0.0
InpAosCellMult=1.0
; === AI OS guardrails L3 / health L4 (defaults off) ===
InpAosCalendarKill=false
InpAosSlipAbortR=0.0
InpAosLotGuardPct=0.0
InpAosDdLimitPct=0.0
InpAosClockRefuse=false
InpAosHealthSizing=false
InpAosHealthBaseE=0.0
InpAosHealthLeakPP=1.0
InpAosCompressRiskPct=0.0
; === Execution ===
InpMagicBase=26110600
InpSlippagePoints=50
InpMaxLot=100.0
