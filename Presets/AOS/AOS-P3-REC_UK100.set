; AOS-P3 recommended guard set for UK100 (forward-test candidate, AOS-P7). Production strategy inputs unchanged.
; L3 on: calendar kill, slippage abort 0.25R, lot guard 10 %, DD limit 13 % (x0.5 at 0.8 x), clock refuse (live).
; L4 observer on (ledger + HEALTH log, baseline E +0.396R), auto-sizing off.
; Live ledger: Common\Files\CycleORB\CORB_<magic>_<symbol>_live_*.csv. Clear a calendar-leak stop by deleting the global variable CORB_<magic>_<symbol>_calkill.
InpServerTZ=1
InpServerFixedOffsetH=0
; === London setup (London local time) = LSE cash open ===
InpLonEnable=true
InpLonRangeStart=08:15
InpLonRangeMinutes=60
InpLonEntryEnd=11:30
InpLonExit=16:25
; === New York setup — OFF ===
InpNYEnable=false
InpNYRangeStart=09:30
InpNYRangeMinutes=30
InpNYEntryEnd=11:00
InpNYExit=11:20
; === Tokyo setup — OFF ===
InpTkyEnable=false
InpTkyRangeStart=09:00
InpTkyRangeMinutes=60
InpTkyEntryEnd=11:30
InpTkyExit=15:25
; === Entry / exit ===
InpStopMode=0
InpTargetR=2.5
InpBufferSpreadMult=2.0
InpBufferRangePct=5.0
; === Filters (regime) ===
InpATRPeriod=14
InpMinRangeATRPct=10.0
InpMaxRangeATRPct=50.0
InpMaxCostRangePct=10.0
InpCommissionPoints=0
InpMinVolPct=33.0
InpVolATRPeriod=20
InpVolLookback=500
InpTrendSideOnly=false
InpTrendMAPeriod=20
; === Calendar - LSE holidays + 12:30 half days 2025-07 -> 2027 ===
InpSkipDates=250825,251224,251225,251226,251231,260101,260403,260406,260504,260525,260831,261224,261225,261228,261231,270101,270326,270329,270503,270531,270830,271224,271227,271228,271231
; === Monthly cycle ===
InpCycleCapital=0.0
InpSoftHaltPct=30.0
InpHardFlattenPct=38.0
InpRatchetArmPct=20.0
InpRatchetFloorPct=10.0
InpRatchetTrail=0.5
InpRiskDivisor=8.0
InpMaxRiskPct=1.0
InpNoEntryLastDay=true
; === AI OS observe (ledger, shadow, features; never changes trading) ===
InpAosLedger=true
InpAosRunTag=
InpAosEventCcy=GBP,EUR,USD
InpAosCtxSymbols=JPN225,SPX500
InpAosCtxHours=8
; === AI OS policy L2 (permit / withhold / resize; defaults = engine unchanged) ===
InpAosLongGate=0
InpAosShortGate=0
InpAosCtxGateATR=0.5
InpAosEventNames=
InpAosEventWindow=0
InpAosEventSizeMult=1.0
InpAosCancelBeforeMin=0
InpAosCellAtrMin=0.0
InpAosCellAtrMax=0.0
InpAosCellMult=1.0
; === AI OS guardrails L3 / health L4 (defaults off) ===
InpAosCalendarKill=true
InpAosSlipAbortR=0.25
InpAosLotGuardPct=10
InpAosDdLimitPct=13
InpAosClockRefuse=true
InpAosHealthSizing=false
InpAosHealthBaseE=0.396
InpAosHealthLeakPP=1.0
InpAosCompressRiskPct=0.0
; === Execution ===
InpMagicBase=26110800
InpSlippagePoints=150
InpMaxLot=100.0
