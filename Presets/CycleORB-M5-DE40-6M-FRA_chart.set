; CycleORB v1.04 (needs v1.04+: H1 volatility regime filter) - DE40 (YWO symbol DE30) M5 chart preset, Frankfurt first-hour ORB (6-month review 2026-05 -> 2026-10)
; Research: Ouroboros research/assets/DE40/CycleORB_M5_chart_preset.md
; Broker clock YWO-Trade = UTC+0 -> fixed offset 0
; Session: "London" setup = Frankfurt clock - 1h all year (EU DST). Range 08:15-09:15 London = 09:15-10:15 Frankfurt, flat 16:00 London = 17:00 Frankfurt (before the 17:30 Xetra close spread widening)
; Geometry: stop = opposite range edge, TP = 2.5 x stop distance (never TP < SL; EA refuses TargetR < 1 and skips any side whose TP distance < SL distance)
; Regime filters: range 10-40% of previous daily ATR(14) AND H1 ATR(20) percentile over 500 H1 bars >= 33 (not the low-vol tercile)
;
; === Server time ===
InpServerTZ=1
InpServerFixedOffsetH=0
; === London setup (London local time) = Frankfurt cash open ===
InpLonEnable=true
InpLonRangeStart=08:15
InpLonRangeMinutes=60
InpLonEntryEnd=11:30
InpLonExit=16:00
; === New York setup - OFF: no stable edge on DE40 (sign flips between windows) ===
InpNYEnable=false
InpNYRangeStart=08:00
InpNYRangeMinutes=30
InpNYEntryEnd=11:30
InpNYExit=15:00
; === Tokyo setup - OFF (explicit: the tester otherwise keeps the last run's Tokyo inputs) ===
InpTkyEnable=false
InpTkyRangeStart=09:00
InpTkyRangeMinutes=60
InpTkyEntryEnd=11:30
InpTkyExit=15:25
; === Entry / exit ===
InpStopMode=0
InpTargetR=2.5
InpBufferSpreadMult=2.0
InpBufferRangePct=5.0
; === Filters (regime) ===
InpATRPeriod=14
InpMinRangeATRPct=10.0
InpMaxRangeATRPct=40.0
InpMaxCostRangePct=10.0
InpCommissionPoints=0
InpMinVolPct=33.0
InpVolATRPeriod=20
InpVolLookback=500
InpTrendSideOnly=false
InpTrendMAPeriod=20
; === Calendar - Xetra holidays 2025-07 -> 2027 ===
InpSkipDates=251224,251225,251226,251231,260101,260403,260406,260501,261224,261225,261231,270101,270326,270329,271224,271231
; === Monthly cycle ===
InpCycleCapital=0.0
InpSoftHaltPct=30.0
InpHardFlattenPct=38.0
InpRatchetArmPct=20.0
InpRatchetFloorPct=10.0
InpRatchetTrail=0.5
InpRiskDivisor=8.0
InpMaxRiskPct=1.0
InpNoEntryLastDay=true
; === AI OS observe (ledger, shadow, features; never changes trading) ===
InpAosLedger=false
InpAosRunTag=
InpAosEventCcy=USD,EUR,GBP,JPY
InpAosCtxSymbols=
InpAosCtxHours=8
; === AI OS policy L2 (permit / withhold / resize; defaults = engine unchanged) ===
InpAosLongGate=0
InpAosShortGate=0
InpAosCtxGateATR=0.5
InpAosEventNames=
InpAosEventWindow=0
InpAosEventSizeMult=1.0
InpAosCancelBeforeMin=0
InpAosCellAtrMin=0.0
InpAosCellAtrMax=0.0
InpAosCellMult=1.0
; === AI OS guardrails L3 / health L4 (defaults off) ===
InpAosCalendarKill=false
InpAosSlipAbortR=0.0
InpAosLotGuardPct=0.0
InpAosDdLimitPct=0.0
InpAosClockRefuse=false
InpAosHealthSizing=false
InpAosHealthBaseE=0.0
InpAosHealthLeakPP=1.0
InpAosCompressRiskPct=0.0
; === Execution ===
InpMagicBase=26110300
InpSlippagePoints=100
InpMaxLot=50.0
