; CycleORB v1.07 (needs v1.07+: TargetR = 1 sides) - MSFT (YWO symbol Microsoft) M5 chart preset, New York post-open ORB
; *** RESEARCH ONLY - NOT PRODUCTION *** framework verdict NEGATIVE: -0.009R/trade on framework default costs (2024-02 -> 2026-10)
; Best EA-runnable cell of a NO-GO review: +0.03R/trade on realistic costs only (Fragile, EF 3.3 < M 6.0 pp); session-gated tip ~0R
; Research: Ouroboros research/assets/MSFT/CycleORB_M5_review.md
; Broker clock YWO-Trade = UTC+0 -> fixed offset 0 (Microsoft history before 2025-06-18 is stamped UTC+3; no bars 2026-05-12 -> 06-30)
; Session: range 09:45-10:00 New York (skips the opening auction), entries until 13:30, flat 14:00
; Geometry: stop = opposite range edge, TP = 1.0 x stop distance (never TP < SL; EA refuses TargetR < 1 and skips any side whose TP distance < SL distance)
; Regime filters: range 20-60% of previous daily ATR(14) AND spread <= 10% of range (wide ranges only, spread is a small share of 1R)
; Known gap: the residual edge sits on H1-ranging days (ER50 < 0.3); trending days lose and the EA cannot filter them
; Risk: 0.5% per trade (half the usual 1%: research preset, negative on framework costs)
;
; === Server time ===
InpServerTZ=1
InpServerFixedOffsetH=0
; === London setup - OFF (Microsoft not quoted in London hours) ===
InpLonEnable=false
InpLonRangeStart=08:00
InpLonRangeMinutes=30
InpLonEntryEnd=11:00
InpLonExit=16:00
; === New York setup (New York local time) ===
InpNYEnable=true
InpNYRangeStart=09:45
InpNYRangeMinutes=15
InpNYEntryEnd=13:30
InpNYExit=14:00
; === Tokyo setup - OFF ===
InpTkyEnable=false
InpTkyRangeStart=09:00
InpTkyRangeMinutes=60
InpTkyEntryEnd=11:30
InpTkyExit=15:25
; === Entry / exit ===
InpStopMode=0
InpTargetR=1.0
InpBufferSpreadMult=1.0
InpBufferRangePct=0.0
; === Filters (regime) ===
InpATRPeriod=14
InpMinRangeATRPct=20.0
InpMaxRangeATRPct=60.0
InpMaxCostRangePct=10.0
InpCommissionPoints=0
InpMinVolPct=0.0
InpVolATRPeriod=20
InpVolLookback=500
InpTrendSideOnly=false
InpTrendMAPeriod=20
; === Calendar - NYSE holidays + 13:00 early closes 2025-07 -> 2027 (exit is after the early close) ===
InpSkipDates=250703,250704,250901,251127,251128,251224,251225,260101,260119,260216,260403,260525,260619,260703,260907,261126,261127,261224,270101,270118,270215,270326,270531,270618,270705,270906,271125,271126,271224
; === Monthly cycle (guards only at 0.5% risk) ===
InpCycleCapital=0.0
InpSoftHaltPct=30.0
InpHardFlattenPct=38.0
InpRatchetArmPct=20.0
InpRatchetFloorPct=10.0
InpRatchetTrail=0.5
InpRiskDivisor=8.0
InpMaxRiskPct=0.5
InpNoEntryLastDay=true
; === AI OS observe (ledger, shadow, features; never changes trading) ===
InpAosLedger=false
InpAosRunTag=
InpAosEventCcy=USD,EUR,GBP,JPY
InpAosCtxSymbols=
InpAosCtxHours=8
; === AI OS policy L2 (permit / withhold / resize; defaults = engine unchanged) ===
InpAosLongGate=0
