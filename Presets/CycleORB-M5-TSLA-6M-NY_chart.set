; CycleORB v1.06 - TSLA (YWO share CFD `Tesla`) M5 chart preset, New York post-open ORB (range 09:45-10:00 NY), regime-filtered (6-month review 2026-05 -> 2026-10)
; Research: Ouroboros research/assets/TSLA/CycleORB_M5_chart_preset.md - status RESEARCH, NOT production-worthy (fragile edge, G2 walk-forward fails)
; Broker clock YWO-Trade = UTC+0 -> fixed offset 0. Tesla quotes 09:30-16:00 New York only; 1 lot = 1 share, min 1 share
; Session: range 09:45-10:00 New York (skips the opening-auction whipsaw), entries until 11:30, flat 15:50 (before the broker's Friday 15:55 NY winter close)
; Geometry: stop = opposite range edge, TP = 2.5 x stop distance (never TP < SL; EA refuses TargetR < 1 and skips any side whose TP distance < SL distance)
; Regime filters: 15-min range 10-40% of previous daily ATR(14) AND spread <= 10% of range AND H1 ATR(20) percentile over 500 H1 bars >= 33 (not the low-vol tercile)
; Risk: 0.5% of month-start balance per trade (framework: edge near frontier -> half of 1%; MC-2 P95 MaxDD 12.6%)
; SESSION WARNING: edge exists only if orders arm at 10:00 NY. If the Journal shows "WAIT NY: trade session closed" (US DST, Mar-Nov), disable: gated variant is negative.
;
; === Server time ===
InpServerTZ=1
InpServerFixedOffsetH=0
; === London setup - OFF: Tesla has no London session ===
InpLonEnable=false
InpLonRangeStart=08:00
InpLonRangeMinutes=30
InpLonEntryEnd=11:00
InpLonExit=16:00
; === New York setup (New York local time) ===
InpNYEnable=true
InpNYRangeStart=09:45
InpNYRangeMinutes=15
InpNYEntryEnd=11:30
InpNYExit=15:50
; === Tokyo setup - OFF ===
InpTkyEnable=false
InpTkyRangeStart=09:00
InpTkyRangeMinutes=60
InpTkyEntryEnd=11:30
InpTkyExit=15:25
; === Entry / exit ===
InpStopMode=0
InpTargetR=2.5
InpBufferSpreadMult=2.0
InpBufferRangePct=5.0
; === Filters (regime) ===
InpATRPeriod=14
InpMinRangeATRPct=10.0
InpMaxRangeATRPct=40.0
InpMaxCostRangePct=10.0
InpCommissionPoints=0
InpMinVolPct=33.0
InpVolATRPeriod=20
InpVolLookback=500
InpTrendSideOnly=false
InpTrendMAPeriod=20
; === Calendar - NYSE holidays + 13:00 early closes 2025-07 -> 2027 (exit is after the early close) ===
InpSkipDates=250703,250704,250901,251127,251128,251224,251225,260101,260119,260216,260403,260525,260619,260703,260907,261126,261127,261224,270101,270118,270215,270326,270531,270618,270705,270906,271125,271126,271224
; === Monthly cycle (guards only at 0.5% risk) ===
InpCycleCapital=0.0
InpSoftHaltPct=30.0
InpHardFlattenPct=38.0
InpRatchetArmPct=20.0
InpRatchetFloorPct=10.0
InpRatchetTrail=0.5
InpRiskDivisor=8.0
InpMaxRiskPct=0.5
InpNoEntryLastDay=true
; === AI OS observe (ledger, shadow, features; never changes trading) ===
InpAosLedger=false
InpAosRunTag=
InpAosEventCcy=USD,EUR,GBP,JPY
InpAosCtxSymbols=
InpAosCtxHours=8
; === AI OS policy L2 (permit / withhold / resize; defaults = engine unchanged) ===
InpAosLongGate=0
InpAosShortGate=0
InpAosCtxGateATR=0.5
InpAosEventNames=
InpAosEventWindow=0
InpAosEventSizeMult=1.0
InpAosCancelBeforeMin=0
InpAosCellAtrMin=0.0
InpAosCellAtrMax=0.0
InpAosCellMult=1.0
; === AI OS guardrails L3 / health L4 (defaults off) ===
InpAosCalendarKill=false
InpAosSlipAbortR=0.0
InpAosLotGuardPct=0.0
InpAosDdLimitPct=0.0
InpAosClockRefuse=false
InpAosHealthSizing=false
InpAosHealthBaseE=0.0
InpAosHealthLeakPP=1.0
InpAosCompressRiskPct=0.0
; === Execution ===
InpMagicBase=26110700
InpSlippagePoints=50
InpMaxLot=100.0
