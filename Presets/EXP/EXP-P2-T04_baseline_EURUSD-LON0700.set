; EXP-P2-T04_baseline_EURUSD-LON0700: export preset for the tester-container parity test (INF-P2-T04). Copy of AOS-P1-T06_L6L1_observeAll_EURUSD-LON0700.set with InpAosRunTag=EXP. EA logic unchanged.
; AOS-P1 observe-all preset for EURUSD-LON0700 (AOS-P1-T01..T06: ledger, shadow, L1 features, events, context)
; Base: CycleORB-M5-EURUSD-LON0700.set (frozen production). Changed inputs: InpAosLedger=true, InpAosRunTag=EXP, InpAosEventCcy=EUR,GBP,USD, InpAosCtxSymbols=JPN225,USDJPY
; Hypothesis: zero behaviour change. Expected skip/fire change: 0 %. Must equal the AOS-P0 baseline event by event (aos_compare: withheld 0, added 0, changed 0)
; CycleORB v1.03 - EURUSD M5 chart preset - London pre-open range (07:00-08:00 London), NY off
; Review: Ouroboros research/assets/EURUSD/CycleORB_M5_LON0700_review.md (6M window 2026-05..2026-10)
; Broker clock: YWO-Trade is UTC since 2026 -> fixed offset 0. The GMT+2/+3 default shifts every window 2-3h.
; Geometry: SL = opposite range edge, TP = 3.0 x SL distance (TP >= SL always; EA refuses TargetR < 1)
; Regime filter: 07:00-08:00 range must be >= 18% of previous daily ATR(14) (skips compressed sessions)
; Risk: 0.5% of month-start capital per trade (framework: P95 MaxDD <= 25%, edge near frontier)
;
; === Server time ===
InpServerTZ=1
InpServerFixedOffsetH=0
; === London setup (London local time) ===
InpLonEnable=true
InpLonRangeStart=07:00
InpLonRangeMinutes=60
InpLonEntryEnd=11:00
InpLonExit=14:00
; === New York setup (New York local time) - OFF: negative out of sample ===
InpNYEnable=false
InpNYRangeStart=08:00
InpNYRangeMinutes=30
InpNYEntryEnd=11:30
InpNYExit=15:00
; === Tokyo setup - OFF (explicit: a chart or the tester keeps the previous value of any input a .set omits) ===
InpTkyEnable=false
InpTkyRangeStart=09:00
InpTkyRangeMinutes=60
InpTkyEntryEnd=11:30
InpTkyExit=15:25
; === Entry / exit ===
InpStopMode=0
InpTargetR=3.0
InpBufferSpreadMult=2.0
InpBufferRangePct=10.0
; === Filters (regime) ===
InpATRPeriod=14
InpMinRangeATRPct=18.0
InpMaxRangeATRPct=100.0
InpMaxCostRangePct=20.0
InpCommissionPoints=0
InpMinVolPct=0.0
InpVolATRPeriod=20
InpVolLookback=500
InpTrendSideOnly=false
InpTrendMAPeriod=20
; === Calendar - none: market trades through local holidays (no failed exits in the 2026 tester run) ===
InpSkipDates=
; === Monthly cycle (guards only at 0.5% risk) ===
InpCycleCapital=0.0
InpSoftHaltPct=30.0
InpHardFlattenPct=38.0
InpRatchetArmPct=20.0
InpRatchetFloorPct=10.0
InpRatchetTrail=0.5
InpRiskDivisor=8.0
InpMaxRiskPct=0.5
InpNoEntryLastDay=true
; === AI OS observe (ledger, shadow, features; never changes trading) ===
InpAosLedger=true
InpAosRunTag=EXP
InpAosEventCcy=EUR,GBP,USD
InpAosCtxSymbols=JPN225,USDJPY
InpAosCtxHours=8
; === AI OS policy L2 (permit / withhold / resize; defaults = engine unchanged) ===
InpAosLongGate=0
InpAosShortGate=0
InpAosCtxGateATR=0.5
InpAosEventNames=
InpAosEventWindow=0
InpAosEventSizeMult=1.0
InpAosCancelBeforeMin=0
InpAosCellAtrMin=0.0
InpAosCellAtrMax=0.0
InpAosCellMult=1.0
; === AI OS guardrails L3 / health L4 (defaults off) ===
InpAosCalendarKill=false
InpAosSlipAbortR=0.0
InpAosLotGuardPct=0.0
InpAosDdLimitPct=0.0
InpAosClockRefuse=false
InpAosHealthSizing=false
InpAosHealthBaseE=0.0
InpAosHealthLeakPP=1.0
InpAosCompressRiskPct=0.0
; === Execution ===
InpMagicBase=26110210
InpSlippagePoints=10
InpMaxLot=50.0
